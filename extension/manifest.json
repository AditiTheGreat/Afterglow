{
  "manifest_version": 3,
  "name": "Afterglow - Spotify Visualiser",
  "version": "1.0.0",
  "description": "Fullscreen, real-time Spotify audio visualiser.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["visualiser-bridge.js"]
    }
  ]
}
